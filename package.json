{
  "name": "sourcelight",
  "private": true,
  "license": "MPL-2.0",
  "version": "0.2.1",
  "type": "module",
  "description": "A local-first raw photo editor and organiser: catalogue, filter, cull and develop raw files from every major camera, with optional on-device AI",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:ai": "tauri dev --features ai",
    "tauri:phone": "tauri dev --features ai,phone-link",
    "android:build": "cd mobile && tauri android build --debug --apk",
    "android:phone": "cd mobile && tauri android build --debug --apk --target aarch64",
    "android:dev": "cd mobile && tauri android dev",
    "tauri:build:ai": "tauri build --features ai --config src-tauri/tauri.ai.conf.json",
    "tauri:build:ai:mac": "tauri build --features ai --config src-tauri/tauri.ai.conf.json --config src-tauri/tauri.ai.macos.conf.json",
    "tauri:build:test": "tauri build --features ai --config src-tauri/tauri.ai.conf.json --config src-tauri/tauri.test.conf.json",
    "tauri:build:test:mac": "tauri build --features ai --bundles app --config src-tauri/tauri.ai.conf.json --config src-tauri/tauri.ai.macos.conf.json --config src-tauri/tauri.test.conf.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:missing": "vite-node scripts/i18n-missing.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "~2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
