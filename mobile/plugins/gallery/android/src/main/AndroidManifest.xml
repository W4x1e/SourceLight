<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only Android 9 and earlier need this to add to the gallery; from 10
         on, an app adds its own photos to MediaStore without asking. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
