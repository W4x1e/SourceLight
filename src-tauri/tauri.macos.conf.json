        "minWidth": 940,
        "minHeight": 620,
        "zoomHotkeysEnabled": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0c0c0e",
        "transparent": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 28
        }
